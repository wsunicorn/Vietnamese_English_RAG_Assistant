APP_NAME="Vietnamese/English RAG Document Assistant"
ENVIRONMENT=development
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
MAX_FILE_MB=25
UPLOAD_DIR=data/uploads

# Database
DATABASE_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag_assistant
AUTO_CREATE_TABLES=true

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse

# AI providers
# LLM_PROVIDER: gemini | groq | openai | openai-compatible | development
# EMBEDDING_PROVIDER: gemini | openai | openai-compatible | hash
#
# Recommended free-ish start:
# - LLM_PROVIDER=gemini
# - EMBEDDING_PROVIDER=gemini
# - GEMINI_API_KEY=your_key_from_google_ai_studio
#
# Groq is fast for chat but does not provide embeddings for this app.
# Pair it with Gemini embeddings:
# - LLM_PROVIDER=groq
# - EMBEDDING_PROVIDER=gemini
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Gemini API via OpenAI-compatible endpoint
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview

# Groq API, chat only
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.1-8b-instant

# OpenAI API
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_REASONING_EFFORT=low

# Any OpenAI-compatible gateway, e.g. OpenRouter, Together, local proxy.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_CHAT_MODEL=
OPENAI_COMPATIBLE_EMBEDDING_MODEL=

EMBEDDING_DIMENSIONS=3072
EMBEDDING_REQUEST_DIMENSIONS=false
TOKENIZER_MODEL=text-embedding-3-large

# Retrieval
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=120
RETRIEVAL_TOP_K=6
RETRIEVAL_PREFETCH_LIMIT=30
NO_ANSWER_MIN_SCORE=0.16

# Cost logging is configurable because provider pricing changes.
INPUT_COST_PER_1M_TOKENS=0
OUTPUT_COST_PER_1M_TOKENS=0
